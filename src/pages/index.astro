---
import Layout from '../layouts/Layout.astro';

const services = [
  { n: '01', name: 'Fit-Out & Interior Approvals' },
  { n: '02', name: 'Interior Designing & Decoration' },
  { n: '03', name: 'Fit-Out Works' },
  { n: '04', name: 'Exhibition Stands' },
  { n: '05', name: 'A/C Supply & Installation' },
  { n: '06', name: 'Electrical & Plumbing Works' },
  { n: '07', name: 'Painting Services' },
  { n: '08', name: 'Masonry Work' },
  { n: '09', name: 'Steel Work' },
  { n: '10', name: 'Glass & Aluminum Works' },
  { n: '11', name: 'Carpentry Works' },
];

const authorities = [
  { name: 'Dubai Municipality', short: 'DM', logo: '/assets/authorities/dm.svg' },
  { name: 'Dubai Civil Defence', short: 'DCD', logo: '/assets/authorities/dcd.png' },
  { name: 'Dubai Development Authority', short: 'DDA', logo: '/assets/authorities/dda.jpg' },
  { name: 'Trakhees', short: 'TRAKHEES', logo: null },
  { name: 'Nakheel', short: 'NAKHEEL NOC', logo: '/assets/authorities/nakheel.svg' },
  { name: 'Emaar', short: 'EMAAR NOC', logo: '/assets/authorities/emaar.svg' },
  { name: 'Dubai Health Authority', short: 'DHA', logo: null },
  { name: 'Dubai Electricity & Water Authority', short: 'DEWA', logo: '/assets/authorities/dewa.png' },
  { name: 'Roads & Transport Authority', short: 'RTA', logo: '/assets/authorities/rta.png' },
  { name: 'Concordia', short: 'CONCORDIA', logo: null },
  { name: 'Jebel Ali Free Zone', short: 'JAFZA NOC', logo: '/assets/authorities/jafza.png' },
  { name: 'Dubai Integrated Economic Zones', short: 'DIEZ', logo: null },
];

const projects = [
  { name: 'Project Name', category: 'Retail Fit-Out' },
  { name: 'Project Name', category: 'Office Interior' },
  { name: 'Project Name', category: 'Residential' },
  { name: 'Project Name', category: 'Exhibition Stand' },
  { name: 'Project Name', category: 'Restaurant Fit-Out' },
  { name: 'Project Name', category: 'Commercial' },
];

const whyChoose = [
  { title: '25+ Years of Expertise', desc: 'We bring a wealth of knowledge and expertise to every project, ensuring outstanding results that exceed expectations.' },
  { title: 'All-in-One Solutions', desc: 'From securing authority approvals to designing and executing intricate interior projects, we offer a tailored, end-to-end solution.' },
  { title: 'Expert Craftsmanship', desc: 'Our team comprises seasoned experts dedicated to maintaining the highest standards of craftsmanship, precision and quality.' },
  { title: 'On-Time Delivery', desc: 'We value your time and guarantee timely project completion without compromising on quality, start to finish.' },
];
---

<Layout>
  <!-- HOME -->
  <section id="home" class="min-h-screen flex flex-col justify-center px-6 md:px-10 border-b border-line">
    <div class="max-w-7xl mx-auto w-full">
      <p class="text-orange uppercase tracking-widest text-xs md:text-sm mb-6">
        Interior Design, Approvals and Fitout
      </p>
      <h1 class="font-display font-semibold text-[13vw] md:text-[7vw] leading-[0.95] tracking-tight">
        HUDUDI<br />INTERIORS
      </h1>
      <p class="mt-8 max-w-xl text-ink/60 text-base leading-relaxed">
        25 years of expertise meets innovation and excellence. Bespoke interior
        design and turnkey fit-out solutions for homes, offices and retail
        spaces across Dubai.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="#contact" class="rounded-lg bg-ink text-paper px-7 py-3.5 text-xs uppercase tracking-widest hover:bg-orange transition-colors">
          Start a project
        </a>
        <a href="#services" class="rounded-lg border border-ink px-7 py-3.5 text-xs uppercase tracking-widest hover:border-orange hover:text-orange transition-colors">
          View services
        </a>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="px-6 md:px-10 py-24 md:py-32 border-b border-line">
    <div class="max-w-7xl mx-auto">
      <h2 class="font-display font-semibold text-4xl md:text-6xl tracking-tight mb-10">
        <span class="text-orange">Welcome</span> to HUDUDI Interiors
      </h2>

      <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center mb-20">
        <div>
          <p class="text-ink/70 text-base leading-relaxed mb-8">
            HUDUDI Interiors is a Dubai-based interior design and fit-out firm
            bringing over 25 years of combined expertise to residential,
            commercial and retail spaces across the UAE.
          </p>
          <h3 class="font-display text-xl md:text-2xl font-medium mb-3">
            Comprehensive Interior Design Solutions
          </h3>
          <p class="text-ink/70 text-base leading-relaxed">
            From securing authority approvals to designing and executing
            intricate interior projects, we offer an all-in-one solution
            tailored to your specific needs, combining innovation,
            functionality and premium craftsmanship in every space we build.
          </p>
        </div>
        <div class="aspect-[4/3] rounded-2xl bg-ink flex items-center justify-center overflow-hidden">
          <span class="font-display text-paper/30 text-sm uppercase tracking-widest">Image of Works</span>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-6 mb-20">
        <div class="rounded-2xl bg-ink text-paper p-8 md:p-10">
          <p class="text-orange uppercase tracking-wide text-2xl md:text-3xl font-display font-semibold mb-4">Our Mission</p>
          <p class="text-base leading-relaxed">
            To provide comprehensive and reliable interior services with
            unmatched quality, ensuring customer satisfaction and fostering
            long-term relationships.
          </p>
        </div>
        <div class="rounded-2xl border-2 border-orange text-ink p-8 md:p-10">
          <p class="text-orange uppercase tracking-wide text-2xl md:text-3xl font-display font-semibold mb-4">Our Vision</p>
          <p class="text-base leading-relaxed">
            To be a leading name in interior designing services, delivering
            innovative solutions that redefine the standards of excellence in
            property enhancement.
          </p>
        </div>
      </div>

      <h3 class="font-display text-2xl md:text-3xl font-semibold mb-10">
        Why Choose <span class="text-orange">HUDUDI Interiors</span> for Your Next Project?
      </h3>
      <div class="grid sm:grid-cols-2 gap-6">
        {whyChoose.map((w) => (
          <div class="rounded-2xl border border-line p-6 md:p-8">
            <h4 class="font-display text-lg font-medium mb-2">{w.title}</h4>
            <p class="text-base text-ink/60 leading-relaxed">{w.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="px-6 md:px-10 py-24 md:py-32 border-b border-line">
    <div class="max-w-7xl mx-auto">
      <h2 class="font-display font-semibold text-4xl md:text-6xl tracking-tight mb-16">Services</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {services.map((s) => (
          <div class="group rounded-2xl border border-line p-5 md:p-6 flex flex-col gap-4 hover:bg-ink hover:border-ink transition-colors">
            <span class="text-orange text-sm font-display">{s.n}</span>
            <h3 class="font-display text-base md:text-lg font-medium leading-snug group-hover:text-paper transition-colors">{s.name}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AUTHORITIES -->
  <section id="authorities" class="px-6 md:px-10 py-24 md:py-32 border-b border-line bg-paper text-ink">
    <div class="max-w-7xl mx-auto">
      <h2 class="font-display font-semibold text-4xl md:text-6xl tracking-tight mb-16">Authorities</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {authorities.map((a) => (
          <div class="rounded-2xl border border-line aspect-[4/3] p-5 md:p-6 flex items-center justify-center">
            {a.logo ? (
              <img src={a.logo} alt={a.name} class="max-h-12 md:max-h-14 max-w-[85%] w-auto h-auto object-contain" />
            ) : (
              <span class="font-display text-ink text-sm md:text-base font-semibold uppercase tracking-wide text-center">
                {a.short}
              </span>
            )}
          </div>
        ))}
      </div>
      <p class="text-base text-ink/40 mt-6">
        Approvals coordinated with the authorities and developers above; logos shown for identification purposes only.
      </p>
    </div>
  </section>

  <!-- PORTFOLIO -->
  <section id="portfolio" class="px-6 md:px-10 py-24 md:py-32 border-b border-line">
    <div class="max-w-7xl mx-auto">
      <h2 class="font-display font-semibold text-4xl md:text-6xl tracking-tight mb-16">Portfolio</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        {projects.map((p) => (
          <div class="group rounded-2xl bg-paper border border-line aspect-[4/3] p-6 flex flex-col justify-end relative overflow-hidden">
            <div class="absolute inset-0 bg-ink/[0.03] group-hover:bg-orange/10 transition-colors"></div>
            <div class="relative">
              <p class="font-display text-lg font-medium">{p.name}</p>
              <p class="text-xs uppercase tracking-widest text-ink/50 mt-1">{p.category}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="text-base text-ink/40 mt-6">* Project images to be added.</p>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="px-6 md:px-10 pt-24 md:pt-32 pb-12 md:pb-16">
    <div class="max-w-7xl mx-auto">
      <h2 class="font-display font-semibold text-4xl md:text-6xl tracking-tight mb-12">
        Let's build<br />something.
      </h2>
      <div class="flex flex-col md:flex-row items-stretch gap-16">
        <div class="rounded-2xl overflow-hidden border border-line aspect-[16/10] md:aspect-auto md:flex-1">
          <iframe
            title="HUDUDI Interiors location"
            class="w-full h-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            src="https://www.google.com/maps?q=HUDUDI+INTERIORS+LLC,25.164863,55.3939104&z=16&output=embed"
          ></iframe>
        </div>
        <form id="contact-form" class="md:flex-1 flex flex-col gap-6">
        <div>
          <label for="name" class="block text-xs uppercase tracking-widest text-ink/50 mb-2">Name</label>
          <input id="name" name="name" type="text" required class="w-full border-b border-line bg-transparent py-3 focus:outline-none focus:border-orange transition-colors" />
        </div>
        <div>
          <label for="email" class="block text-xs uppercase tracking-widest text-ink/50 mb-2">Email</label>
          <input id="email" name="email" type="email" required class="w-full border-b border-line bg-transparent py-3 focus:outline-none focus:border-orange transition-colors" />
        </div>
        <div>
          <label for="message" class="block text-xs uppercase tracking-widest text-ink/50 mb-2">Message</label>
          <textarea id="message" name="message" rows="4" required class="w-full border-b border-line bg-transparent py-3 focus:outline-none focus:border-orange transition-colors resize-none"></textarea>
        </div>
        <button type="submit" class="rounded-lg bg-ink text-paper px-7 py-3.5 text-xs uppercase tracking-widest hover:bg-orange transition-colors">
          Send message
        </button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = encodeURIComponent(String(data.get('name') ?? ''));
    const email = encodeURIComponent(String(data.get('email') ?? ''));
    const message = encodeURIComponent(String(data.get('message') ?? ''));
    const subject = encodeURIComponent(`New enquiry from ${data.get('name')}`);
    const body = `Name: ${name}%0AEmail: ${email}%0A%0A${message}`;
    window.location.href = `mailto:info@hududi.com?subject=${subject}&body=${body}`;
  });
</script>
