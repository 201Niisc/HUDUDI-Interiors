---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects.js';

const services = [
  { n: '01', name: 'Fit-Out & Interior Approvals' },
  { n: '02', name: 'Interior Designing & Decoration' },
  { n: '03', name: 'Fit-Out Works' },
  { n: '04', name: 'Exhibition Stands' },
  { n: '05', name: 'A/C Supply & Installation' },
  { n: '06', name: 'Electrical & Plumbing Works' },
  { n: '07', name: 'Painting Services' },
  { n: '08', name: 'Masonry Work' },
  { n: '09', name: 'Steel Work' },
  { n: '10', name: 'Glass & Aluminum Works' },
  { n: '11', name: 'Carpentry Works' },
];

const authorities = [
  { name: 'Dubai Municipality', short: 'DM', logo: '/assets/authorities/dm.svg' },
  { name: 'Dubai Civil Defense', short: 'DCD', logo: '/assets/authorities/dcd.png' },
  { name: 'Dubai Development Authority', short: 'DDA', logo: '/assets/authorities/dda.jpg' },
  { name: 'Trakhees', short: 'TRAKHEES', logo: '/assets/authorities/trakhees.avif' },
  { name: 'Nakheel', short: 'NAKHEEL NOC', logo: '/assets/authorities/nakheel.svg' },
  { name: 'Emaar', short: 'EMAAR NOC', logo: '/assets/authorities/emaar.svg' },
  { name: 'Dubai South', short: 'DUBAI SOUTH', logo: '/assets/authorities/dubai-south.svg' },
  { name: 'Dubai Electricity & Water Authority', short: 'DEWA', logo: '/assets/authorities/dewa.png' },
  { name: 'Dubai Silicon Oasis', short: 'DSO', logo: '/assets/authorities/dso.png' },
  { name: 'Concordia', short: 'CONCORDIA', logo: '/assets/authorities/concordia.png' },
  { name: 'Jebel Ali Free Zone', short: 'JAFZA NOC', logo: '/assets/authorities/jafza.png' },
  { name: 'Dubai Holding', short: 'DUBAI HOLDING', logo: '/assets/authorities/dubai-holding.avif' },
];

const whyChoose = [
  { title: 'All-in-One Solutions', desc: 'From design and fit-out approvals to executing the works, we offer a tailored, end-to-end solution for every stage of your project.', image: '/assets/stock-photos/1.jpg' },
  { title: 'In-House Design Team', desc: 'Our dedicated in-house designers work with you from concept to completion, ensuring a cohesive vision and full control over quality at every stage.', image: '/assets/stock-photos/2.jpg' },
  { title: 'On-Time Delivery', desc: 'We value your time and guarantee timely project completion without compromising on quality, start to finish.', image: '/assets/stock-photos/3.jpg' },
  { title: 'Expert Craftsmanship', desc: 'Our team comprises seasoned experts dedicated to maintaining the highest standards of craftsmanship, precision and quality.', image: '/assets/stock-photos/4.jpg' },
];

const testimonials = [
  { quote: 'Very professional team following up all the step of the process. Team always available to clarify any details and doubts. Thank you!', name: 'Samanta Capra' },
  { quote: 'Hududi interiors.. Such an amazing guys they deliver a spectacular output which is more than my expectations.', name: 'Dhibinraj T.' },
  { quote: 'Amazing service, they helped with all necessary approvals on time.', name: 'Sankar Vasudev' },
  { quote: 'Excellent service from Hududi Interiors. They managed all approvals quickly and delivered a high-quality fit-out on time. Highly professional and reliable team in the UAE.', name: 'Merin Alexander' },
  { quote: "I've known the owners for many years and use their company as subcontractor. They are very fast with any kind of government approvals and their work ethics and execution is very professional. Highly recommend their services for any fit-out or interior designs work.", name: 'A.S., Business Owner' },
  { quote: 'Hududi Interiors did an amazing job transforming my space. Their team was professional, efficient, and paid attention to every detail. The quality of work was excellent, and they completed everything on time. Highly recommend for anyone looking for top-notch interior design in Dubai.', name: 'Nidhin Anil' },
  { quote: 'Great work, fast approvals. Dedicated staff, professional team. On time works completion, highly recommended.', name: 'Mithu Prem' },
  { quote: 'HUDUDI INTERIORS LLC delivers innovative, high-quality designs, enhancing functionality and aesthetics. Clients benefit from their commitment to excellence.', name: 'Geethi C' },
];
---

<Layout>
  <Fragment slot="cover">
    <section id="landing" class="landing relative h-screen w-full flex items-center justify-center overflow-hidden">
      <div class="landing-bg absolute inset-0"></div>
      <div class="landing-content relative z-10 flex flex-col items-center text-center px-6">
        <img src="/assets/logo/hududi-icon.png" alt="" class="w-24 md:w-32 h-auto mb-8" />
        <h1 class="font-display font-semibold text-paper text-[10vw] md:text-[5.5vw] leading-[0.92] tracking-tight">
          HUDUDI<br />INTERIORS
        </h1>
        <p class="mt-6 text-orange uppercase tracking-widest text-xs md:text-sm">
          Service meets satisfaction
        </p>
        <p class="mt-3 text-paper uppercase tracking-widest text-[10px] md:text-xs">
          Interior Design | Approvals | Fitout
        </p>
      </div>
      <a
        href="#home"
        aria-label="Scroll to explore"
        class="landing-scroll absolute bottom-9 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2 text-paper/50 hover:text-orange transition-colors"
      >
        <span class="text-[10px] uppercase tracking-widest">Scroll</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5v14M5 12l7 7 7-7" />
        </svg>
      </a>
    </section>
    <div
      id="heroImage"
      class="hero-image-float hidden lg:block"
      style="background-image: url('/assets/stock-photos/welcome-hero.jpg'); background-size: cover; background-position: center;"
      aria-hidden="true"
    ></div>
  </Fragment>

  <!-- HOME -->
  <section id="home" class="px-6 md:px-10 py-24 md:py-32 border-b border-line">
    <div class="max-w-7xl mx-auto reveal relative z-10">
      <h2 class="font-display font-semibold text-4xl md:text-6xl tracking-tight mb-10">
        <span class="text-orange">Welcome</span> to HUDUDI Interiors
      </h2>

      <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-start mb-20">
        <div>
            <p class="text-ink/70 text-base leading-relaxed mb-8">
              We are a Design and Engineering studio with 15+ years of
              experience, focused on fit-out approvals, design and
              execution, delivering commercial and retail spaces across
              Dubai. Our in-house team handles every stage under one roof,
              from initial concept and authority approvals through to
              fit-out and final handover, so you deal with a single point
              of contact throughout.
            </p>
            <h3 class="font-display text-xl md:text-2xl font-medium mb-3">
              Expert Fit-Out Authority Approvals
            </h3>
            <p class="text-ink/70 text-base leading-relaxed">
              We deliver every project with utmost dedication and clarity,
              keeping you updated at every stage, with no drawbacks in
              design, communication or execution. We stay closely engaged
              with the relevant authorities to keep approvals on track, and
              provide consistent progress updates so nothing catches you by
              surprise.
            </p>
          </div>
          <img
            id="heroImageTarget"
            src="/assets/stock-photos/welcome-hero.jpg"
            alt="HUDUDI Interiors completed works"
            class="aspect-[4/3] w-full rounded-2xl object-cover"
          />
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="rounded-2xl bg-ink text-paper p-8 md:p-10">
            <p class="text-orange uppercase tracking-wide text-2xl md:text-3xl font-display font-semibold mb-4">Our Mission</p>
            <p class="text-base leading-relaxed">
              We are committed to delivering efficient and reliable interior
              solutions with unwavering dedication, ensuring complete
              customer satisfaction and building lasting relationships.
            </p>
          </div>
          <div class="rounded-2xl border-2 border-orange text-ink p-8 md:p-10">
            <p class="text-orange uppercase tracking-wide text-2xl md:text-3xl font-display font-semibold mb-4">Our Vision</p>
            <p class="text-base leading-relaxed">
              To be a leading name in Architectural and Interior Services,
              delivering innovative solutions that redefine the standards of
              excellence in property enhancement.
            </p>
          </div>
        </div>
      </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="px-6 md:px-10 py-24 md:py-32 border-b border-line">
    <div class="max-w-7xl mx-auto reveal">
      <h3 class="font-display text-2xl md:text-3xl font-semibold mb-10">
        Why Choose <span class="text-orange">HUDUDI Interiors</span> for Your Next Project?
      </h3>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {whyChoose.map((w) => (
          <div>
            <div class="relative aspect-[3/4] rounded-2xl overflow-hidden">
              <img src={w.image} alt={w.title} class="absolute inset-0 w-full h-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/10 to-transparent"></div>
              <p class="absolute bottom-4 left-4 right-4 text-paper font-display text-lg font-medium leading-snug">{w.title}</p>
            </div>
            <p class="mt-4 text-base text-ink/60 leading-relaxed">{w.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="px-6 md:px-10 py-24 md:py-32 border-b border-line">
    <div class="max-w-7xl mx-auto reveal">
      <h2 class="font-display font-semibold text-4xl md:text-6xl tracking-tight mb-16">Services</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {services.map((s) => (
          <div class="group rounded-2xl border border-line p-5 md:p-6 flex flex-col gap-4 hover:bg-ink hover:border-ink transition-colors">
            <span class="text-orange text-sm font-display">{s.n}</span>
            <h3 class="font-display text-base md:text-lg font-medium leading-snug group-hover:text-paper transition-colors">{s.name}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AUTHORITIES -->
  <section id="authorities" class="px-6 md:px-10 py-24 md:py-32 border-b border-line bg-paper text-ink">
    <div class="max-w-7xl mx-auto reveal">
      <h2 class="font-display font-semibold text-4xl md:text-6xl tracking-tight mb-16">Authorities</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {authorities.map((a) => (
          <div class="rounded-2xl border border-line aspect-[4/3] p-5 md:p-6 flex items-center justify-center">
            {a.logo ? (
              <img src={a.logo} alt={a.name} class="max-h-12 md:max-h-14 max-w-[85%] w-auto h-auto object-contain" />
            ) : (
              <span class="font-display text-ink text-sm md:text-base font-semibold uppercase tracking-wide text-center">
                {a.short}
              </span>
            )}
          </div>
        ))}
      </div>
      <p class="text-base text-ink/40 mt-6">
        Approvals coordinated with the authorities and developers above; logos shown for identification purposes only.
      </p>
    </div>
  </section>

  <!-- PORTFOLIO -->
  <section id="portfolio" class="px-6 md:px-10 py-24 md:py-32 border-b border-line">
    <div class="max-w-7xl mx-auto reveal">
      <h2 class="font-display font-semibold text-4xl md:text-6xl tracking-tight mb-16">Portfolio</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        {projects.map((p) => {
          const hasImage = p.images && p.images.length > 0;
          return (
            <a
              href={`/portfolio/${p.slug}`}
              class={`group rounded-2xl border border-line aspect-[4/3] p-6 flex flex-col justify-end relative overflow-hidden ${hasImage ? '' : 'bg-paper'}`}
              style={!hasImage ? `view-transition-name: project-image-${p.slug}` : undefined}
            >
              {hasImage && (
                <img
                  src={p.images[0]}
                  alt={p.name}
                  class="absolute inset-0 w-full h-full object-cover"
                  style={`view-transition-name: project-image-${p.slug}`}
                  loading="lazy"
                />
              )}
              <div class={`absolute inset-0 transition-colors ${hasImage ? 'bg-gradient-to-t from-ink/80 via-ink/10 to-transparent' : 'bg-ink/[0.03] group-hover:bg-orange/10'}`}></div>
              <span class={`absolute top-6 right-6 text-[10px] uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity ${hasImage ? 'text-paper' : 'text-orange'}`}>
                View project →
              </span>
              <div class="relative">
                <p class={`font-display text-lg font-medium ${hasImage ? 'text-paper' : ''}`}>{p.name}</p>
                <p class={`text-xs uppercase tracking-widest mt-1 ${hasImage ? 'text-paper/70' : 'text-ink/50'}`}>{p.category}</p>
              </div>
            </a>
          );
        })}
      </div>
      <p class="text-base text-ink/40 mt-6">* Project images to be added.</p>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="px-6 md:px-10 py-24 md:py-32 border-b border-line">
    <div class="max-w-7xl mx-auto reveal">
      <h2 class="font-display font-semibold text-4xl md:text-6xl tracking-tight mb-12">
        Let's build<br />something.
      </h2>
      <div class="flex flex-col md:flex-row items-stretch gap-16">
        <div class="rounded-2xl overflow-hidden border border-line aspect-[16/10] md:aspect-auto md:flex-1">
          <iframe
            title="HUDUDI Interiors location"
            class="w-full h-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            src="https://www.google.com/maps?q=25.164863,55.3939104&z=16&output=embed"
          ></iframe>
        </div>
        <form id="contact-form" class="md:flex-1 flex flex-col gap-6">
        <div>
          <label for="name" class="block text-xs uppercase tracking-widest text-ink/50 mb-2">Name</label>
          <input id="name" name="name" type="text" required class="w-full border-b border-line bg-transparent py-3 focus:outline-none focus:border-orange transition-colors" />
        </div>
        <div>
          <label for="email" class="block text-xs uppercase tracking-widest text-ink/50 mb-2">Email</label>
          <input id="email" name="email" type="email" required class="w-full border-b border-line bg-transparent py-3 focus:outline-none focus:border-orange transition-colors" />
        </div>
        <div>
          <label for="message" class="block text-xs uppercase tracking-widest text-ink/50 mb-2">Message</label>
          <textarea id="message" name="message" rows="4" required class="w-full border-b border-line bg-transparent py-3 focus:outline-none focus:border-orange transition-colors resize-none"></textarea>
        </div>
        <button type="submit" class="rounded-lg bg-ink text-paper px-7 py-3.5 text-xs uppercase tracking-widest hover:bg-orange transition-colors">
          Send message
        </button>
        </form>
      </div>
    </div>
  </section>

  <!-- TESTIMONIAL -->
  <section id="testimonial" class="px-6 md:px-10 pt-24 md:pt-32 pb-12 md:pb-16">
    <div class="max-w-7xl mx-auto reveal">
      <h2 class="font-display font-semibold text-4xl md:text-6xl tracking-tight mb-16">What Our Clients Say</h2>
      <div class="rounded-2xl bg-paper border-2 border-orange text-ink p-10 md:p-16 relative overflow-hidden">
        <svg class="text-orange w-12 h-12 md:w-16 md:h-16 mb-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.571-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-3.983v-10h9.983z" />
        </svg>
        <div id="testimonialSlides">
          {testimonials.map((t, i) => (
            <div class="testimonial-slide" data-index={i} style={i === 0 ? undefined : 'display:none;'}>
              <p class="text-base md:text-lg leading-relaxed max-w-4xl">
                {t.quote}
              </p>
              <p class="mt-8 text-orange uppercase tracking-widest text-xs md:text-sm">
                {t.name}
              </p>
            </div>
          ))}
        </div>
        <div class="flex items-center gap-2 mt-10">
          {testimonials.map((_, i) => (
            <button
              class="testimonial-dot w-2 h-2 rounded-full bg-orange/25 transition-colors"
              data-index={i}
              aria-label={`Show testimonial ${i + 1}`}
            ></button>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.testimonial-slide'));
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.testimonial-dot'));

  if (slides.length > 1) {
    let active = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const setDot = (i: number) => {
      dots.forEach((d, di) => d.classList.toggle('bg-orange', di === i));
      dots.forEach((d, di) => d.classList.toggle('bg-orange/25', di !== i));
    };

    const show = (next: number) => {
      const current = slides[active];
      const upcoming = slides[next];
      current.style.opacity = '0';
      setTimeout(() => {
        current.style.display = 'none';
        upcoming.style.display = '';
        requestAnimationFrame(() => {
          upcoming.style.opacity = '1';
        });
      }, 300);
      active = next;
      setDot(active);
    };

    slides.forEach((s) => {
      s.style.transition = 'opacity 0.3s ease';
      s.style.opacity = '1';
    });
    setDot(0);

    const advance = () => show((active + 1) % slides.length);

    const startTimer = () => {
      if (prefersReducedMotion) return;
      timer = setInterval(advance, 4000);
    };
    const stopTimer = () => {
      if (timer) clearInterval(timer);
      timer = null;
    };

    dots.forEach((d) => {
      d.addEventListener('click', () => {
        const i = Number(d.dataset.index);
        if (i === active) return;
        stopTimer();
        show(i);
        startTimer();
      });
    });

    const section = document.getElementById('testimonial');
    section?.addEventListener('mouseenter', stopTimer);
    section?.addEventListener('mouseleave', startTimer);

    startTimer();
  }
</script>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = encodeURIComponent(String(data.get('name') ?? ''));
    const email = encodeURIComponent(String(data.get('email') ?? ''));
    const message = encodeURIComponent(String(data.get('message') ?? ''));
    const subject = encodeURIComponent(`New enquiry from ${data.get('name')}`);
    const body = `Name: ${name}%0AEmail: ${email}%0A%0A${message}`;
    window.location.href = `mailto:info@hududi.com?subject=${subject}&body=${body}`;
  });
</script>

<script>
  const heroImage = document.getElementById('heroImage');
  const heroTarget = document.getElementById('heroImageTarget');

  if (heroImage && heroTarget) {
    const mq = window.matchMedia('(min-width: 1024px)');
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    let ticking = false;

    // The shrink itself stays fast (done within one viewport height, same
    // pace as the landing -> home scroll snap) so the box is already small
    // before the hero text is on screen. The target lives further down the
    // page now, so once shrunk it just keeps tracking the target's live
    // position and glides into place like a normal element as you scroll on.
    const render = () => {
      ticking = false;
      if (!mq.matches) return;
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const t = heroTarget.getBoundingClientRect();
      const progress = Math.min(Math.max(window.scrollY / vh, 0), 1);

      heroImage.style.top = `${lerp(0, t.top, progress)}px`;
      heroImage.style.left = `${lerp(0, t.left, progress)}px`;
      heroImage.style.width = `${lerp(vw, t.width, progress)}px`;
      heroImage.style.height = `${lerp(vh, t.height, progress)}px`;
      heroImage.style.borderRadius = `${lerp(0, 16, progress)}px`;
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(render);
      }
    };

    const syncVisibility = () => {
      heroImage.style.display = mq.matches ? 'block' : 'none';
      render();
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    window.addEventListener('load', render);
    mq.addEventListener('change', syncVisibility);
    syncVisibility();
  }
</script>
