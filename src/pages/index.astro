---
import Layout from '../layouts/Layout.astro';

const services = [
  { n: '01', name: 'Fit-Out & Interior Approvals', desc: 'Obtaining approvals from DEWA, Dubai Civil Defence, Dubai Municipality, TRAKHEES, DDA, Dubai Silicon Oasis Authority, CONCORDIA and other developers.' },
  { n: '02', name: 'Interior Designing & Decoration', desc: 'Custom residential and commercial designs that balance innovation, function and visual appeal.' },
  { n: '03', name: 'Fit-Out Works', desc: 'End-to-end fit-out for restaurants, offices, salons and pharmacies — creative design met with operational precision.' },
  { n: '04', name: 'Exhibition Stands', desc: 'Concept, fabrication, installation and delivery of turnkey trade show displays.' },
  { n: '05', name: 'A/C Supply & Installation', desc: 'Climate control systems including unit supply, ductwork and ongoing maintenance.' },
  { n: '06', name: 'Electrical & Plumbing Works', desc: 'Professional installation and repair prioritising precision, safety and reliability.' },
  { n: '07', name: 'Painting Services', desc: 'Finishing for walls, ceilings and furniture — combining aesthetic quality with durability.' },
  { n: '08', name: 'Masonry Work', desc: 'Structural integrity and visual appeal through quality brick and stone construction.' },
  { n: '09', name: 'Steel Work', desc: 'Custom fabrication including mezzanine floors and racking systems.' },
  { n: '10', name: 'Glass & Aluminum Works', desc: 'Precision-crafted partitions and decorative elements for interior spaces.' },
  { n: '11', name: 'Carpentry Works', desc: 'Custom woodwork — ceilings, partitions, office furniture and doors in premium materials.' },
];

const projects = [
  { n: '01', name: 'Project Name', category: 'Retail Fit-Out' },
  { n: '02', name: 'Project Name', category: 'Office Interior' },
  { n: '03', name: 'Project Name', category: 'Residential' },
  { n: '04', name: 'Project Name', category: 'Exhibition Stand' },
  { n: '05', name: 'Project Name', category: 'Restaurant Fit-Out' },
  { n: '06', name: 'Project Name', category: 'Commercial' },
];
---

<Layout>
  <!-- HOME -->
  <section id="home" class="min-h-[calc(100vh-73px)] flex flex-col justify-center px-6 md:px-10 border-b border-line">
    <div class="max-w-7xl mx-auto w-full">
      <p class="text-orange uppercase tracking-widest text-xs md:text-sm mb-6">
        Fit-Out &amp; Interior Design — Dubai, UAE
      </p>
      <h1 class="font-display font-semibold text-[13vw] md:text-[7vw] leading-[0.95] tracking-tight">
        HUDUDI<br />INTERIORS
      </h1>
      <p class="mt-8 max-w-xl text-ink/60 text-base md:text-lg leading-relaxed">
        25 years of expertise meets innovation and excellence. Bespoke interior
        design and turnkey fit-out solutions for homes, offices and retail
        spaces across Dubai.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="#contact" class="bg-ink text-paper px-7 py-3.5 text-xs uppercase tracking-widest hover:bg-orange transition-colors">
          Start a project
        </a>
        <a href="#services" class="border border-ink px-7 py-3.5 text-xs uppercase tracking-widest hover:border-orange hover:text-orange transition-colors">
          View services
        </a>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="px-6 md:px-10 py-24 md:py-32 border-b border-line">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-end justify-between mb-16 gap-6 flex-wrap">
        <h2 class="font-display font-semibold text-4xl md:text-6xl tracking-tight">Services</h2>
        <p class="text-ink/50 max-w-sm text-sm leading-relaxed">
          Full-scope interior services — from authority approvals to final finish —
          managed under one roof.
        </p>
      </div>
      <div>
        {services.map((s) => (
          <div class="group border-t border-line py-6 md:py-8 flex flex-col md:flex-row md:items-center gap-3 md:gap-10 hover:bg-ink hover:text-paper transition-colors px-2 md:px-4 -mx-2 md:-mx-4">
            <span class="text-orange text-sm md:text-base font-display shrink-0 w-10">{s.n}</span>
            <h3 class="font-display text-xl md:text-2xl font-medium md:w-80 shrink-0">{s.name}</h3>
            <p class="text-sm leading-relaxed opacity-70 group-hover:opacity-90">{s.desc}</p>
          </div>
        ))}
        <div class="border-t border-line"></div>
      </div>
    </div>
  </section>

  <!-- PORTFOLIO -->
  <section id="portfolio" class="px-6 md:px-10 py-24 md:py-32 border-b border-line">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-end justify-between mb-16 gap-6 flex-wrap">
        <h2 class="font-display font-semibold text-4xl md:text-6xl tracking-tight">Portfolio</h2>
        <p class="text-ink/50 max-w-sm text-sm leading-relaxed">
          A selection of completed fit-outs and interiors across Dubai.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-line">
        {projects.map((p) => (
          <div class="group bg-paper aspect-[4/3] p-6 flex flex-col justify-between relative overflow-hidden">
            <div class="absolute inset-0 bg-ink/[0.03] group-hover:bg-orange/10 transition-colors"></div>
            <span class="relative text-xs text-ink/40 font-display">{p.n}</span>
            <div class="relative">
              <p class="font-display text-lg font-medium">{p.name}</p>
              <p class="text-xs uppercase tracking-widest text-ink/50 mt-1">{p.category}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="text-xs text-ink/40 mt-6">* Project images to be added.</p>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="px-6 md:px-10 py-24 md:py-32 border-b border-line">
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-16">
      <div>
        <h2 class="font-display font-semibold text-4xl md:text-6xl tracking-tight mb-8">About</h2>
        <p class="text-ink/70 text-base md:text-lg leading-relaxed">
          HUDUDI Interiors is a Dubai-based interior design and fit-out firm
          bringing over 25 years of combined expertise to residential,
          commercial and retail spaces — offering comprehensive, end-to-end
          project management from authority approvals through final execution.
        </p>
      </div>
      <div class="space-y-10">
        <div>
          <p class="text-orange uppercase tracking-widest text-xs mb-2">Mission</p>
          <p class="text-ink/70 leading-relaxed">
            To provide comprehensive and reliable interior services with
            unmatched quality, ensuring customer satisfaction and fostering
            long-term relationships.
          </p>
        </div>
        <div>
          <p class="text-orange uppercase tracking-widest text-xs mb-2">Vision</p>
          <p class="text-ink/70 leading-relaxed">
            To be a leading name in interior designing services, delivering
            innovative solutions that redefine the standards of excellence in
            property enhancement.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-6 pt-4">
          <div class="border-t border-line pt-4">
            <p class="font-display text-3xl font-semibold">25+</p>
            <p class="text-xs uppercase tracking-widest text-ink/50 mt-1">Years of expertise</p>
          </div>
          <div class="border-t border-line pt-4">
            <p class="font-display text-3xl font-semibold">11</p>
            <p class="text-xs uppercase tracking-widest text-ink/50 mt-1">Services offered</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="px-6 md:px-10 py-24 md:py-32">
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-16">
      <div>
        <h2 class="font-display font-semibold text-4xl md:text-6xl tracking-tight mb-8">
          Let's build<br />something.
        </h2>
        <div class="space-y-6 text-sm">
          <div>
            <p class="text-orange uppercase tracking-widest text-xs mb-2">Email</p>
            <a href="mailto:info@hududi.com" class="text-lg hover:text-orange transition-colors">info@hududi.com</a>
          </div>
          <div>
            <p class="text-orange uppercase tracking-widest text-xs mb-2">Phone</p>
            <a href="tel:+97142998374" class="block text-lg hover:text-orange transition-colors">+971 4 299 8374</a>
            <a href="tel:+971505232713" class="block text-lg hover:text-orange transition-colors">+971 50 523 2713</a>
          </div>
          <div>
            <p class="text-orange uppercase tracking-widest text-xs mb-2">Office</p>
            <p class="text-lg leading-snug">
              Office No. 1151, 1st Floor, H-Block,<br />Souk Warsan, Dubai, UAE
            </p>
          </div>
        </div>
      </div>
      <form id="contact-form" class="space-y-6">
        <div>
          <label for="name" class="block text-xs uppercase tracking-widest text-ink/50 mb-2">Name</label>
          <input id="name" name="name" type="text" required class="w-full border-b border-line bg-transparent py-3 focus:outline-none focus:border-orange transition-colors" />
        </div>
        <div>
          <label for="email" class="block text-xs uppercase tracking-widest text-ink/50 mb-2">Email</label>
          <input id="email" name="email" type="email" required class="w-full border-b border-line bg-transparent py-3 focus:outline-none focus:border-orange transition-colors" />
        </div>
        <div>
          <label for="message" class="block text-xs uppercase tracking-widest text-ink/50 mb-2">Message</label>
          <textarea id="message" name="message" rows="4" required class="w-full border-b border-line bg-transparent py-3 focus:outline-none focus:border-orange transition-colors resize-none"></textarea>
        </div>
        <button type="submit" class="bg-ink text-paper px-7 py-3.5 text-xs uppercase tracking-widest hover:bg-orange transition-colors">
          Send message
        </button>
      </form>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = encodeURIComponent(String(data.get('name') ?? ''));
    const email = encodeURIComponent(String(data.get('email') ?? ''));
    const message = encodeURIComponent(String(data.get('message') ?? ''));
    const subject = encodeURIComponent(`New enquiry from ${data.get('name')}`);
    const body = `Name: ${name}%0AEmail: ${email}%0A%0A${message}`;
    window.location.href = `mailto:info@hududi.com?subject=${subject}&body=${body}`;
  });
</script>
