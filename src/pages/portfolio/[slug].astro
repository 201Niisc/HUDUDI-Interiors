---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects.js';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const images = project.images ?? [];
const heroTransitionName = `view-transition-name: project-image-${project.slug}`;
---

<Layout
  title={project.name}
  description={`${project.name} — ${project.category} project by HUDUDI Interiors in ${project.location}.`}
>
  <section class="px-6 md:px-10 pt-16 md:pt-24">
    <div class="max-w-7xl mx-auto reveal">
      <a
        href="/#portfolio"
        class="inline-flex items-center gap-2 text-xs uppercase tracking-widest text-ink/50 hover:text-orange transition-colors mb-10 md:mb-14"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        Back to Portfolio
      </a>

      <div class="grid md:grid-cols-[220px_1fr] lg:grid-cols-[260px_1fr] gap-10 md:gap-16">
        <div class="space-y-8">
          <div>
            <h1 class="font-display font-semibold text-3xl md:text-4xl tracking-tight leading-tight">{project.name}</h1>
            <p class="text-orange uppercase tracking-widest text-xs mt-2">{project.category}</p>
          </div>
          <div class="space-y-5 text-sm">
            <div>
              <p class="text-ink/40 uppercase tracking-widest text-[10px] mb-1">Location</p>
              <p>{project.location ?? '—'}</p>
            </div>
            <div>
              <p class="text-ink/40 uppercase tracking-widest text-[10px] mb-1">Authorities</p>
              <p>{(project.authorities ?? []).join(', ') || '—'}</p>
            </div>
            <div>
              <p class="text-ink/40 uppercase tracking-widest text-[10px] mb-1">Scope of Work</p>
              <p>{(project.scopeOfWork ?? []).join(', ') || '—'}</p>
            </div>
            <div>
              <p class="text-ink/40 uppercase tracking-widest text-[10px] mb-1">Status</p>
              <p>{project.status ?? '—'}</p>
            </div>
            <div>
              <p class="text-ink/40 uppercase tracking-widest text-[10px] mb-1">Year</p>
              <p>{project.year ?? '—'}</p>
            </div>
          </div>
        </div>

        <div class="min-w-0">
          {images.length > 0 ? (
            <img
              src={images[0]}
              alt={project.name}
              class="aspect-[16/10] w-full rounded-2xl overflow-hidden object-cover"
              style={heroTransitionName}
            />
          ) : (
            <div class="aspect-[16/10] rounded-2xl overflow-hidden landing-bg" style={heroTransitionName}></div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Full-bleed from the right edge of the sidebar to the right edge of the viewport -->
  {images.length > 1 ? (
    <div class="hscroll flex gap-3 md:gap-4 overflow-x-auto mt-8 md:mt-10 pb-16 md:pb-24">
      {images.slice(1).map((src, i) => (
        <img
          src={src}
          alt={`${project.name} — image ${i + 2}`}
          class="h-[432px] sm:h-[540px] w-auto shrink-0 rounded-2xl first:ml-6 md:first:ml-10 last:mr-6 md:last:mr-10"
          loading="lazy"
          draggable="false"
        />
      ))}
    </div>
  ) : (
    <div class="hscroll flex gap-3 md:gap-4 overflow-x-auto mt-8 md:mt-10 pb-16 md:pb-24">
      <div class="h-[432px] sm:h-[540px] w-[432px] sm:w-[540px] shrink-0 rounded-2xl overflow-hidden landing-bg first:ml-6 md:first:ml-10"></div>
      <div class="h-[432px] sm:h-[540px] w-[432px] sm:w-[540px] shrink-0 rounded-2xl overflow-hidden landing-bg"></div>
      <div class="h-[432px] sm:h-[540px] w-[432px] sm:w-[540px] shrink-0 rounded-2xl overflow-hidden landing-bg last:mr-6 md:last:mr-10"></div>
    </div>
  )}
  {images.length === 0 && (
    <p class="px-6 md:px-10 pb-16 md:pb-24 text-base text-ink/40">* Project images to be added.</p>
  )}
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('.hscroll').forEach((el) => {
    let isDown = false;
    let startX = 0;
    let scrollStart = 0;

    el.addEventListener('mousedown', (e) => {
      isDown = true;
      startX = e.pageX;
      scrollStart = el.scrollLeft;
      el.classList.add('dragging');
    });
    window.addEventListener('mouseup', () => {
      isDown = false;
      el.classList.remove('dragging');
    });
    window.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      el.scrollLeft = scrollStart - (e.pageX - startX);
    });
  });
</script>
