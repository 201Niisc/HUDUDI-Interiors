---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects.js';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
---

<Layout
  title={project.name}
  description={project.description ?? `${project.name} — ${project.category} project by HUDUDI Interiors.`}
>
  <section class="px-6 md:px-10 py-16 md:py-24">
    <div class="max-w-7xl mx-auto reveal">
      <a
        href="/#portfolio"
        class="inline-flex items-center gap-2 text-xs uppercase tracking-widest text-ink/50 hover:text-orange transition-colors mb-10 md:mb-14"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        Back to Portfolio
      </a>

      <div class="grid md:grid-cols-[220px_1fr] lg:grid-cols-[260px_1fr] gap-10 md:gap-16">
        <div class="space-y-8">
          <div>
            <h1 class="font-display font-semibold text-3xl md:text-4xl tracking-tight leading-tight">{project.name}</h1>
            <p class="text-orange uppercase tracking-widest text-xs mt-2">{project.category}</p>
          </div>
          <div class="space-y-5 text-sm">
            <div>
              <p class="text-ink/40 uppercase tracking-widest text-[10px] mb-1">Client</p>
              <p>{project.client ?? '—'}</p>
            </div>
            <div>
              <p class="text-ink/40 uppercase tracking-widest text-[10px] mb-1">Location</p>
              <p>{project.location ?? '—'}</p>
            </div>
            <div>
              <p class="text-ink/40 uppercase tracking-widest text-[10px] mb-1">Size</p>
              <p>{project.size ?? '—'}</p>
            </div>
            <div>
              <p class="text-ink/40 uppercase tracking-widest text-[10px] mb-1">Status</p>
              <p>{project.status ?? '—'}</p>
            </div>
            <div>
              <p class="text-ink/40 uppercase tracking-widest text-[10px] mb-1">Year</p>
              <p>{project.year ?? '—'}</p>
            </div>
          </div>
        </div>

        <div>
          <div
            class="aspect-[16/10] rounded-2xl overflow-hidden landing-bg"
            style={`view-transition-name: project-image-${project.slug}`}
          >
          </div>
          <p class="mt-10 text-ink/70 leading-relaxed max-w-2xl">
            {project.description ?? 'Project description to be added once details are confirmed.'}
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
