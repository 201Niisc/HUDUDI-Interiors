---
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Fit-Out & Interior Design in Dubai',
  description = '25 years of expertise meets innovation and excellence. Fit-out, interior design and technical solutions for homes, offices and retail spaces across Dubai.',
  image = '/assets/logo/hududi-interiors-logo.png',
} = Astro.props;

const hasCover = Astro.slots.has('cover');
const pageTitle = `${title} | HUDUDI Interiors`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: 'HUDUDI Interiors L.L.C.',
  image: ogImageURL.toString(),
  url: Astro.site?.toString(),
  telephone: '+971505232713',
  email: 'info@hududi.com',
  description,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Office No. 1151, 1st Floor, H-Block, Souk Warsan',
    addressLocality: 'Dubai',
    addressCountry: 'AE',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 25.164863,
    longitude: 55.3939104,
  },
  areaServed: 'Dubai, United Arab Emirates',
  sameAs: ['https://instagram.com/hududi.services'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      if (!location.hash) {
        window.scrollTo(0, 0);
        window.addEventListener('load', () => window.scrollTo(0, 0));
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon-256.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f27a35" />
    <meta name="view-transition" content="same-origin" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HUDUDI Interiors" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="en_AE" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
  </head>
  <body>
    <Sidebar startHidden={hasCover} />
    <slot name="cover" />
    <div class="flex min-h-screen flex-col md:pl-[240px]">
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<script>
  const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
  );
  revealEls.forEach((el) => revealObserver.observe(el));
</script>

<script>
  if ('onwheel' in window) {
    let current = window.scrollY;
    let target = window.scrollY;
    let raf: number | null = null;
    let lastWheelTime = 0;
    const easeFactor = 0.085;

    const getMax = () => document.documentElement.scrollHeight - window.innerHeight;

    let homeTop = document.getElementById('home')?.offsetTop ?? 0;
    const refreshHomeTop = () => {
      homeTop = document.getElementById('home')?.offsetTop ?? 0;
    };

    const clampTarget = () => {
      target = Math.min(Math.max(target, 0), Math.max(getMax(), 0));
    };

    const loop = () => {
      current += (target - current) * easeFactor;
      if (Math.abs(target - current) < 0.5) current = target;
      window.scrollTo({ top: current, left: 0, behavior: 'instant' });
      raf = current !== target ? requestAnimationFrame(loop) : null;
    };

    const ensureLoop = () => {
      if (raf === null) raf = requestAnimationFrame(loop);
    };

    window.addEventListener(
      'wheel',
      (e) => {
        if (e.ctrlKey) return;
        const now = performance.now();
        if (now - lastWheelTime > 200) {
          current = window.scrollY;
          target = window.scrollY;
        }
        lastWheelTime = now;
        e.preventDefault();

        if (e.deltaY > 0 && current < homeTop) {
          // one scroll carries the whole landing screen straight to home
          target = homeTop;
        } else if (e.deltaY < 0 && current <= homeTop) {
          // and one scroll back up returns straight to the landing screen
          target = 0;
        } else {
          target += e.deltaY;
        }
        clampTarget();
        ensureLoop();
      },
      { passive: false }
    );

    window.addEventListener('resize', () => {
      refreshHomeTop();
      clampTarget();
    });

    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement)?.closest?.('a[href^="#"]') as HTMLAnchorElement | null;
      if (!a) return;
      const id = a.getAttribute('href')?.slice(1);
      if (!id) return;
      const el = document.getElementById(id);
      if (!el) return;
      e.preventDefault();
      const marginTop = parseFloat(getComputedStyle(el).scrollMarginTop) || 0;
      current = window.scrollY;
      target = el.getBoundingClientRect().top + window.scrollY - marginTop;
      clampTarget();
      history.pushState(null, '', `#${id}`);
      ensureLoop();
    });
  }
</script>
