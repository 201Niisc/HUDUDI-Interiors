---
const year = new Date().getFullYear();
---

<footer class="bg-ink text-paper mt-32">
  <div class="max-w-7xl mx-auto px-6 md:px-10 py-16 grid gap-12 md:grid-cols-4">
    <div class="md:col-span-2">
      <p class="font-display text-2xl font-semibold mb-4">
        HUDUDI <span class="text-orange">INTERIORS</span>
      </p>
      <p class="text-paper/60 text-sm leading-relaxed max-w-sm">
        25 years of expertise meets innovation and excellence — fit-out, interior
        design and technical solutions for homes, offices and retail spaces across Dubai.
      </p>
    </div>
    <div class="text-sm space-y-2">
      <p class="uppercase tracking-widest text-orange text-xs mb-3">Contact</p>
      <p><a href="mailto:info@hududi.com" class="text-paper/70 hover:text-orange">info@hududi.com</a></p>
      <p><a href="tel:+97142998374" class="text-paper/70 hover:text-orange">+971 4 299 8374</a></p>
      <p><a href="tel:+971505232713" class="text-paper/70 hover:text-orange">+971 50 523 2713</a></p>
    </div>
    <div class="text-sm space-y-2">
      <p class="uppercase tracking-widest text-orange text-xs mb-3">Office</p>
      <p class="text-paper/70">
        Office No. 1151, 1st Floor, H-Block,<br />
        Souk Warsan, Dubai, UAE
      </p>
      <p class="pt-2">
        <a href="https://instagram.com/hududi.services" target="_blank" rel="noopener" class="text-paper/70 hover:text-orange">
          Instagram
        </a>
      </p>
    </div>
  </div>
  <div class="border-t border-paper/10 py-5 text-center text-xs text-paper/40">
    &copy; {year} HUDUDI Interiors L.L.C. All rights reserved.
  </div>
</footer>
