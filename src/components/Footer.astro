---
const year = new Date().getFullYear();
---

<footer class="bg-ink text-paper mt-12 md:mt-16">
  <div class="max-w-7xl mx-auto px-6 md:px-10 py-12 grid gap-9 md:grid-cols-3">
    <div>
      <p class="font-display text-2xl font-semibold mb-4">
        HUDUDI <span class="text-orange">INTERIORS</span>
      </p>
      <p class="text-orange text-sm uppercase tracking-widest">
        Service meets satisfaction
      </p>
    </div>
    <div class="text-base space-y-1.5">
      <p class="uppercase tracking-widest text-orange text-xs mb-3">Contact</p>
      <a href="mailto:info@hududi.com" class="block text-paper/70 hover:text-orange whitespace-nowrap">info@hududi.com</a>
      <a href="tel:+97142998374" class="block text-paper/70 hover:text-orange whitespace-nowrap">+971 4 299 8374</a>
      <a href="tel:+971505232713" class="block text-paper/70 hover:text-orange whitespace-nowrap">+971 50 523 2713</a>
    </div>
    <div class="text-base space-y-2">
      <p class="uppercase tracking-widest text-orange text-xs mb-3">Office</p>
      <p class="text-paper/70">
        Office No. 1151, 1st Floor, H-Block,<br />
        Souk Warsan, Dubai, UAE
      </p>
