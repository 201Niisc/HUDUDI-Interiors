---
const navItems = [
  { href: '#home', label: 'Home', n: '01' },
  { href: '#services', label: 'Services', n: '02' },
  { href: '#portfolio', label: 'Portfolio', n: '03' },
  { href: '#about', label: 'About', n: '04' },
  { href: '#contact', label: 'Contact', n: '05' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-paper/90 backdrop-blur border-b border-line">
  <div class="max-w-7xl mx-auto flex items-center justify-between px-6 md:px-10 py-5">
    <a href="#home" class="font-display text-lg font-semibold tracking-tight">
      HUDUDI <span class="text-orange">INTERIORS</span>
    </a>
    <nav class="hidden md:flex gap-10 text-xs tracking-widest uppercase">
      {navItems.map((item) => (
        <a href={item.href} class="group flex items-center gap-1.5 hover:text-orange transition-colors">
          <span class="text-[10px] text-ink/40 group-hover:text-orange">{item.n}</span>
          {item.label}
        </a>
      ))}
    </nav>
    <a
      href="#contact"
      class="hidden md:inline-block bg-ink text-paper px-5 py-2.5 text-xs uppercase tracking-widest hover:bg-orange transition-colors"
    >
      Get a quote
    </a>
    <button id="menu-toggle" class="md:hidden text-2xl leading-none" aria-label="Toggle menu">
      &#9776;
    </button>
  </div>
  <nav id="mobile-menu" class="hidden md:hidden flex-col gap-1 px-6 pb-6 text-sm uppercase tracking-widest">
    {navItems.map((item) => (
      <a href={item.href} class="block py-2 border-b border-line/60 hover:text-orange">
        <span class="text-ink/40 mr-2">{item.n}</span>{item.label}
      </a>
    ))}
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      menu.classList.remove('flex');
    })
  );
</script>
